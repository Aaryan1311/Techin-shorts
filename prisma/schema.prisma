generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // hashed password for credentials auth
  name      String?
  avatarUrl String?

  preferredLanguage Language  @default(ENGLISH)
  onboarded         Boolean   @default(false)
  isAdmin           Boolean   @default(false)
  role              UserRole?
  quizCompletedAt   DateTime?

  tagFollows        UserTagFollow[]
  newsInteractions  UserNewsInteraction[]
  behaviors         UserBehavior[]
  topicScores       UserTopicScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  color String @default("#6366f1") // Tailwind indigo-500

  newsItems NewsTag[]
  followers UserTagFollow[]

  createdAt DateTime @default(now())

  @@map("tags")
}

model News {
  id       String @id @default(cuid())
  title    String
  summary          String // 60-80 word short summary shown on the card
  summaryHi        String? // Hindi translation in देवनागरी
  summaryHinglish  String? // Hinglish (romanized Hindi)
  sourceUrl  String? // original article link
  source     String? // e.g. "hackernews", "reddit", "techcrunch", "theverge", "github"
  imageUrl   String?

  // AI-generated extended content (populated later via Claude API)
  detailContent   String? // full "Read Detail" content
  futureImpact    String? // "Future Impact" section
  buildOnThis     String? // "Build on This" project ideas

  // Audio URLs for each language (populated later via TTS)
  audioUrlEn      String?
  audioUrlHi      String?
  audioUrlHinglish String?

  // Audio data stored as base64 (for serverless deployments with read-only fs)
  audioDataEn       String? @db.Text
  audioDataHi       String? @db.Text
  audioDataHinglish String? @db.Text

  // Engagement metrics (denormalized for fast reads)
  likeCount    Int @default(0)
  dislikeCount Int @default(0)
  viewCount    Int @default(0)

  // AI classification scores (from Stage 1 curator)
  trendingScore    Float @default(0)
  qualityScore     Float @default(0)
  relevanceScore   Float @default(0)

  // If dislike ratio is too high, stop recommending
  isActive Boolean @default(true)

  tags         NewsTag[]
  interactions UserNewsInteraction[]
  behaviors    UserBehavior[]

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

// Many-to-many: News <-> Tag
model NewsTag {
  newsId String
  tagId  String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@map("news_tags")
}

// Which tags a user follows (kept for backward compatibility)
model UserTagFollow {
  userId String
  tagId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, tagId])
  @@map("user_tag_follows")
}

// Like/dislike tracking per user per news item
model UserNewsInteraction {
  id     String          @id @default(cuid())
  userId String
  newsId String

  type   InteractionType // LIKE or DISLIKE

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, newsId]) // one interaction per user per news item
  @@map("user_news_interactions")
}

// Behavioral tracking — every user interaction with an article
model UserBehavior {
  id              String       @id @default(cuid())
  userId          String
  newsId          String
  type            BehaviorType
  durationSeconds Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, newsId, type])
  @@map("user_behaviors")
}

// Precomputed interest vector per user per tag
model UserTopicScore {
  id        String @id @default(cuid())
  userId    String
  tagSlug   String
  score     Float  @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([userId, tagSlug])
  @@map("user_topic_scores")
}

enum InteractionType {
  LIKE
  DISLIKE
}

enum Language {
  ENGLISH
  HINDI
  HINGLISH
}

enum UserRole {
  DEVELOPER
  QA_TESTER
  DESIGNER
  PRODUCT_MANAGER
  DATA_ANALYST
  DEVOPS_ENGINEER
  ENGINEERING_MANAGER
  FOUNDER
}

enum BehaviorType {
  VIEW
  READ_SUMMARY
  CLICK_DETAIL
  CLICK_FUTURE
  CLICK_BUILD
  READ_DETAIL
  SHARE
}

// Temporary storage for RSS items awaiting AI processing (one-at-a-time pipeline)
model PendingArticle {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  sourceUrl   String   @unique
  source      String
  imageUrl    String?
  pubDate     DateTime?
  createdAt   DateTime @default(now())

  @@map("pending_articles")
}
